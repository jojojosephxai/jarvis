# Copy this file to .env.local and fill in a key only if you have one.
# The Face screen does not call the brain yet. This key is unused until then.

# From https://console.x.ai — never commit the real key.
XAI_API_KEY=

# Optional. grok-4.3 is the default because it can answer with reasoning turned off.
XAI_MODEL=grok-4.3

# Optional: none, low, medium, or high. grok-4.3 defaults to none.
XAI_REASONING=none

# The Face graph reads the vault folder in this project.
# Set this only if the notes live somewhere else. Jarvis only reads that folder.
# OBSIDIAN_VAULT_PATH=/absolute/path/to/vault
