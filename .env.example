# Copy this file to .env.local. Jarvis answers from the vault with no key.

# Brain reads markdown notes from this folder and nowhere else.
# If this is unset, Jarvis uses the vault folder in the project.
# On Joseph's computer that can be the full path to the vault folder.
# OBSIDIAN_VAULT_PATH=

# Optional. Leave this empty and Jarvis still answers by quoting the notes.
# A key from https://console.x.ai lets Grok word those same notes.
# Grok is not allowed to add facts. Claude is not used.
# The default model is grok-4.3 with reasoning off, because that stays cheaper.
XAI_API_KEY=

# Optional. grok-4.3 is the default.
XAI_MODEL=grok-4.3

# Optional: none, low, medium, or high. grok-4.3 defaults to none.
XAI_REASONING=none
