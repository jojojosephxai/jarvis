# Copy to .env for local Node (home). On Vercel, set these in the dashboard instead.

# Preferred at home: Cursor Pro → https://cursor.com/dashboard/cloud-agents
CURSOR_API_KEY=

# School / Vercel path + optional local: xAI API key (NOT SuperGrok chat alone)
# https://console.x.ai/
XAI_API_KEY=

# Optional password so a public Vercel URL can't burn your key
# In the HUD type: unlock your-password
JARVIS_ACCESS_KEY=

# auto | cursor | grok  (local bridge only; Vercel always uses Grok)
JARVIS_BRAIN=auto

# JARVIS_CURSOR_MODEL=composer-2
# JARVIS_GROK_MODEL=grok-3-mini
# JARVIS_BRIDGE_PORT=8790
