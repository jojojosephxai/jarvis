# Copy to .env and fill in. .env is gitignored — never paste keys into the HUD, chat, or git.
# Restart `npm run jarvis` after changing this file.

# Talk (Grok). Mint at https://console.x.ai
# SuperGrok chat login is NOT this key.
XAI_API_KEY=
XAI_MODEL=grok-4.6

# File / HUD edits (local Cursor agent, not a silent cloud PR).
