# Copy this file to .env.local. Jarvis answers from the vault even with no key.

# Brain reads markdown notes from this folder and nowhere else.
# If this is unset, Jarvis uses the vault folder in the project.
# The Face graph reads that same folder.
# "Remember that…" writes a line into this same folder. See WRITEBACK.md.
# OBSIDIAN_VAULT_PATH=

# From https://console.x.ai — never commit the real key.
# With a key, Grok words the vault notes. It is not allowed to add facts.
# Claude is not used. A missing key does not block answers.
XAI_API_KEY=

# Locked. The server calls model id grok-4.7. It does not use grok-4.3 or any other id.
XAI_MODEL=grok-4.7

# Optional: none, low, medium, or high. grok-4.7 uses low when this is unset.
XAI_REASONING=low
