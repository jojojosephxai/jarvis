# Copy this file to .env.local. Do not commit the real key.
# With no key, Jarvis still reads the vault. With a key, chat calls grok-4.7.

# Brain reads markdown notes from this folder and nowhere else.
# If this is unset, Jarvis uses the vault folder in the project.
# The Face graph reads that same folder.
# "Remember that…" writes a line into this same folder. See WRITEBACK.md.
# OBSIDIAN_VAULT_PATH=

# From https://console.x.ai — never commit the real key.
# With a key, normal chat calls grok-4.7. Matching vault notes are context.
# A missing note does not skip the model. Claude is not used.
# A missing key does not block the local note reader.
XAI_API_KEY=

# Talk model. Default and lock: grok-4.7. Other ids, including Claude, are not sent.
GROK_MODEL=grok-4.7

# Older name. The server ignores this and still calls grok-4.7.
XAI_MODEL=grok-4.7

# Optional: none, low, medium, or high. grok-4.7 uses low when this is unset.
XAI_REASONING=low

# Speak uses Grok text-to-speech on the server when the key and a voice id are both set.
# The key never goes to the browser. If either is empty, Speak uses this computer's voice.
# Altair is the butler voice. Speed is clamped between 0.7 and 1.5. 1 is normal.
XAI_TTS_VOICE_ID=altair
XAI_TTS_SPEED=1

# Older Azure speech settings. Speak does not use these.
# Azure Speech free (F0) tier: 0.5 million neural characters a month.
# Create a Speech resource in the Azure portal, then copy the key and region (for example eastus or uksouth).
# https://portal.azure.com
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional. Default is en-GB-SoniaNeural. Also en-GB-RyanNeural or en-GB-LibbyNeural.
# A voice that is not British neural is ignored, and Sonia is used.
AZURE_SPEECH_VOICE=en-GB-SoniaNeural
