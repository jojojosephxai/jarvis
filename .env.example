# Copy to .env and fill one or both keys. Never commit .env.

# Preferred: Cursor Pro → Dashboard → API Keys / Cloud Agents
# https://cursor.com/dashboard/cloud-agents
CURSOR_API_KEY=

# Optional fast chat: xAI API key (NOT the same as SuperGrok chat subscription)
# https://console.x.ai/
XAI_API_KEY=

# auto | cursor | grok  (auto = Cursor first, then Grok)
JARVIS_BRAIN=auto

# Optional model overrides
# JARVIS_CURSOR_MODEL=composer-2
# JARVIS_GROK_MODEL=grok-3-mini

# JARVIS_BRIDGE_PORT=8790
