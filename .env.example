# Copy this file to .env.local and fill in a key only if you have one.
# Jarvis runs the demo brain with no key.

# From https://console.x.ai — never commit the real key.
XAI_API_KEY=

# Optional. grok-4.3 is the default because it can answer with reasoning turned off.
XAI_MODEL=grok-4.3

# Optional: none, low, medium, or high. grok-4.3 defaults to none.
XAI_REASONING=none

# Folder to open in Obsidian, and the folder Brain can search.
# "vault" works when Jarvis is started from this project folder.
# On Joseph's PC: C:\Users\hosef japosef\Documents\tmp-310a2048b18e7d16\vault
# Jarvis only reads that folder. It does not change the notes.
OBSIDIAN_VAULT_PATH=vault
